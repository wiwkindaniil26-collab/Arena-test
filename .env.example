# --- обязательное ---
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- необязательное (значения по умолчанию) ---
# Где хранить базу и временные файлы
DB_PATH=data/music.db
DOWNLOAD_DIR=data/downloads

# Telegram Bot API отдаёт ботам файлы до 50 МБ (2 ГБ при локальном Bot API server)
MAX_FILE_SIZE_MB=50

# Сколько загрузок выполнять параллельно
MAX_CONCURRENT_DOWNLOADS=3

# Сколько результатов показывать в поиске
SEARCH_RESULTS=5

# Антифлуд: N загрузок за WINDOW секунд на пользователя
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=60

# Качество mp3
AUDIO_QUALITY=192

# Netscape-cookies.txt для источников, требующих входа (например, приватный VK-контент).
# ВНИМАНИЕ: используй только свой аккаунт и только контент, на который у тебя есть права.
# COOKIES_FILE=/app/data/cookies.txt

# Прокси для yt-dlp (например, http://user:pass@host:port)
# PROXY=

# Белый список Telegram user id через запятую. Пусто = бот открыт для всех.
# ALLOWED_USERS=111111111,222222222

LOG_LEVEL=INFO
