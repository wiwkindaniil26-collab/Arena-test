# --- обязательное ---
# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# --- необязательное (значения по умолчанию) ---
# Где хранить базу и временные файлы
DB_PATH=data/music.db
DOWNLOAD_DIR=data/downloads

# Telegram Bot API отдаёт ботам файлы до 50 МБ (2 ГБ при локальном Bot API server)
MAX_FILE_SIZE_MB=50

# Сколько загрузок выполнять параллельно
MAX_CONCURRENT_DOWNLOADS=3

# Сколько результатов показывать в поиске
SEARCH_RESULTS=5

# Антифлуд: N загрузок за WINDOW секунд на пользователя
RATE_LIMIT_COUNT=10
RATE_LIMIT_WINDOW=60

# Качество mp3
AUDIO_QUALITY=192

# Netscape-cookies.txt для источников, требующих входа (например, приватный VK-контент).
# ВНИМАНИЕ: используй только свой аккаунт и только контент, на который у тебя есть права.
# COOKIES_FILE=/app/data/cookies.txt

# Прокси для yt-dlp (например, http://user:pass@host:port)
# PROXY=

# Белый список Telegram user id через запятую. Пусто = бот открыт для всех.
# ALLOWED_USERS=111111111,222222222

LOG_LEVEL=INFO

# --- режим работы ---
# polling — локально/VPS (по умолчанию), webhook — Cloudflare Containers и PaaS
RUN_MODE=polling
# Публичный адрес бота; обязателен при RUN_MODE=webhook
# WEBHOOK_BASE_URL=https://tg-music-bot.username.workers.dev
# WEBHOOK_PATH=/webhook
# Токен, которым Telegram подписывает апдейты (сильно рекомендуется)
# WEBHOOK_SECRET=change-me
# HTTP-сервер в webhook-режиме
HOST=0.0.0.0
PORT=8080

# Cookies строкой (для хостингов без постоянного диска, например Cloudflare)
# COOKIES_CONTENT='# Netscape HTTP Cookie File ...'

